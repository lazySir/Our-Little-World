{
  "name": "@our-little-world/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./date": {
      "types": "./dist/date.d.ts",
      "default": "./dist/date.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./growth": {
      "types": "./dist/growth.d.ts",
      "default": "./dist/growth.js"
    },
    "./baby-album": {
      "types": "./dist/baby-album.d.ts",
      "default": "./dist/baby-album.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.23.0"
  }
}
