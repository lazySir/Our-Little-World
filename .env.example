# Relative paths here are resolved from the repository root by scripts/*.
DATABASE_URL=file:./data/world.db
STORAGE_DIR=./storage
WEB_DIST_DIR=./apps/web/dist
HOST=0.0.0.0
PORT=3000
RUST_LOG=info
# 24 hours by default; keep the newest 7 automatic ZIP backups. 0 disables.
# Allowed positive interval: 1 to 596 hours. First backup follows one full interval.
AUTO_BACKUP_HOURS=24
# npm run init creates a persistent random value; keep it private and backed up.
ASSET_SECRET=
# Optional first-space setup token (minimum 32 bytes, maximum 256 characters); otherwise read storage/.setup-token.
SETUP_TOKEN=
# Exact browser origins, separated by commas. Same-origin production needs none.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Comma-separated trusted reverse-proxy IPs/CIDRs. Empty means no forwarded headers are trusted.
TRUSTED_PROXY_CIDRS=
# Per-client limits and window for login/setup/join and other API requests.
AUTH_RATE_LIMIT=20
GENERAL_RATE_LIMIT=600
RATE_LIMIT_WINDOW_MS=60000
# Web normally uses the development proxy / same-origin production API.
VITE_API_BASE=/api
