DATABASE_URL=file:../../../data/world.db
PORT=3000
HOST=0.0.0.0
STORAGE_DIR=../../storage
# Production: set a persistent random value (minimum 32 characters).
ASSET_SECRET=
# Comma-separated exact browser origins. Empty means same-origin only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Comma-separated trusted reverse-proxy IPs/CIDRs. Empty means no forwarded headers are trusted.
TRUSTED_PROXY_CIDRS=

