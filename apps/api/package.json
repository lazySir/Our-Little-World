{
  "name": "@our-little-world/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "predev": "npm run db:generate",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "prebuild": "npm run db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "npm run db:generate",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "pretest": "npm run db:generate",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:dev": "prisma migrate dev --config prisma.config.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "adm-zip": "^0.6.1",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "multer": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.0",
    "@types/method-override": "^3.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
